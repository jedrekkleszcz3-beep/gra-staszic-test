{
 "cleanUrls": true,
 "rewrites": [
  {
   "source": "/api/:path*",
   "destination": "/api"
  }
 ],
 "functions": {
  "api/index.js": {
   "includeFiles": "data/game.json"
  }
 },
 "headers": [
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "X-Content-Type-Options",
     "value": "nosniff"
    }
   ]
  }
 ]
}